{
  "additional_checks": [
    {
      "name": "e2e-lowest-default",
      "job": {
        "php": "@latest",
        "command": "composer update --prefer-lowest; diff <(./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.default.neon --no-progress --error-format=junit | xmllint --format -) ./test/e2e/default-lowest.output"
      }
    },
    {
      "name": "e2e-latest-default",
      "job": {
        "php": "@latest",
        "command": "diff <(./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.default.neon --no-progress --error-format=junit | xmllint --format -) ./test/e2e/default.output"
      }
    },
    {
      "name": "e2e-recommend",
      "job": {
        "php": "@latest",
        "command": "diff <(./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.recommend.neon --no-progress --error-format=junit | xmllint --format -) ./test/e2e/recommend.output"
      }
    },
    {
      "name": "e2e-enableContextTypeRule",
      "job": {
        "php": "@latest",
        "command": "diff <(./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.enableContextTypeRule.neon --no-progress --error-format=junit | xmllint --format -) ./test/e2e/enableContextTypeRule.output"
      }
    },
    {
      "name": "sfp-phpstan-psr-log-bigquery-schema-convert",
      "job": {
        "php": "@latest",
        "command": "diff <(cat test/unit/TypeProvider/data/bigQuerySchema.json | ./bin/sfp-phpstan-psr-log-bigquery-schema-convert) <(echo -n 'array{first_name?: string, product?: array{id?: string, ...}, cancellation_reason?: float|int|numeric-string, cancellation_date?: \\DateTimeInterface, exception?: \\Throwable, ...}')"
      }
    }
  ],
  "ignore_php_platform_requirements": {
    "8.6": true
  }
}
