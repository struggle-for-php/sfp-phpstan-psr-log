# usage.
# ./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.default.neon
#
# docker run -v $(realpath .):/github/workspace -w=/github/workspace ghcr.io/laminas/laminas-continuous-integration:1 \
#  '{"php":"8.2","dependencies":"latest","extensions":[],"ini":["memory_limit=-1"],"command":"./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.default.neon --no-progress --error-format=junit | xmllint --format -"}'
# docker run -v $(realpath .):/github/workspace -w=/github/workspace ghcr.io/laminas/laminas-continuous-integration:1 \
#  '{"php":"8.2","dependencies":"latest","extensions":[],"ini":["memory_limit=-1"],"command":"diff <(./vendor/bin/phpstan analyse -c ./test/e2e/phpstan.default.neon --no-progress --error-format=junit | xmllint --format -) ./test/test/e2e.default.output"}'

parameters:
	level: 5
	bootstrapFiles:
		- %currentWorkingDirectory%/vendor/autoload.php
	paths:
		- %currentWorkingDirectory%/test/e2e/src

includes:
	- %currentWorkingDirectory%/rules.neon
